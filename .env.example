# Proveedor de LLM. Ver docs/decisions/ADR-003-llm-provider.md
# La interfaz de src/lib/llm.ts abstrae el proveedor: cambiar de uno a otro es
# cambiar estas variables, no tocar el pipeline.
LLM_PROVIDER=openai

# --- OpenAI (activo) ---
OPENAI_API_KEY=
# Modelo frontera para split y extract (las dos etapas con lenguaje real)
OPENAI_MODEL=gpt-5.5
# Modelo barato para iterar en desarrollo y candidato para el crítico
OPENAI_MODEL_CHEAP=gpt-5.4-mini

# --- Anthropic (alternativa para la comparativa del día 4) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Caché local en disco de respuestas del modelo.
# Hace el harness determinista, el desarrollo casi gratis, y desriesga la demo
# si falla la red en la sala. Ver ADR-004.
LLM_CACHE=on
LLM_CACHE_DIR=data/output/.llm-cache

# Umbrales de confianza. Justificación en docs/02-kpi.md §4
THRESHOLD_REVIEW=0.55
THRESHOLD_HIGH=0.90

# Políticas — conmutables en caliente durante el challenge.
# Ver src/rules/policies.ts y docs/03-policies.md
POLICY_FINISH_SET_SCOPE=whole_set
POLICY_IMPLICIT_MULTIPLICITY=infer_one
POLICY_MATERIAL_DERIVATION=from_quality
POLICY_UNITLESS_LENGTH=plausibility_range
POLICY_MISSING_STANDARD=review
POLICY_QUALITY_COHERENCE=review
