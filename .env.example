# ---------------------------------------------------------------------------
# NIVELES DE MODELO
#
# Un nivel = una línea: provider:model:precioIn:precioOut[:precioCachedIn]
# Precios en USD por millón de tokens. Van PEGADOS al modelo a propósito: separados, alguien
# cambia de modelo y la tarifa se queda, y el €/fila del 2-pager se vuelve falso en silencio.
#
# main    filas multi-elemento, donde existe el riesgo de atribución
# cheap   filas de un solo elemento, que no tienen dónde equivocarse
# critic  la red de seguridad. Sólo puede degradar, así que un modelo débil aquí es seguro:
#         su peor caso es no aportar nada. Es el sitio natural para un modelo abierto.
#
# Tarifas OpenAI: developers.openai.com/api/docs/pricing · 2026-08-22
# Tarifas OpenRouter: openrouter.ai/api/v1/models · 2026-08-22
# ---------------------------------------------------------------------------
# ELEGIDO (2026-08-22). Iguala a gpt-5.5 en el gold —211/211 celdas ciertas, error silencioso 0%—
# y cuesta 176x menos en salida. La decisión y su argumento, en docs/05-results.md.
LLM_MAIN=openrouter:openai/gpt-oss-120b:0.03:0.17
LLM_CHEAP=openrouter:openai/gpt-oss-120b:0.03:0.17
LLM_CRITIC=openrouter:openai/gpt-oss-120b:0.03:0.17

# La referencia con la que se calibró el prompt. SIN CRÉDITO en la cuenta desde 2026-08-22, así que
# dejarla activa hace que el front falle en la primera fila.
#   LLM_MAIN=openai:gpt-5.5:5.00:30.00:0.50
#   LLM_CHEAP=openai:gpt-5.4:2.50:15.00:0.25

# Alternativa 100% abierta vía OpenRouter. La salida es el 96% del coste, y estos modelos la
# facturan dos órdenes de magnitud más baja: gpt-oss-120b sale a ~0,00014 €/fila frente a 0,0235.
# Eso NO los hace la elección correcta: hace que la decisión dependa sólo del acierto, que es la
# forma honesta de tomarla. Sin medir, no se cambia.
#   LLM_MAIN=openrouter:deepseek/deepseek-v3.2:0.269:0.400
#   LLM_CHEAP=openrouter:openai/gpt-oss-120b:0.03:0.17
#   LLM_CRITIC=openrouter:openai/gpt-oss-120b:0.03:0.17
# Gratis, para medir sin gastar (con límite de peticiones):
#   LLM_CHEAP=openrouter:z-ai/glm-5.2:free:0:0

OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Para el €/fila que pide el enunciado. BCE 2026-08-21.
EUR_PER_USD=1.1679

# Caché local en disco de respuestas del modelo.
# Hace el harness determinista, el desarrollo casi gratis, y desriesga la demo
# si falla la red en la sala. Ver ADR-004.
# Plazo por petición. Sin esto, fetch de Node espera indefinidamente y una petición colgada
# es indistinguible de una caída, pero sin mensaje de error.
LLM_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# LATENCIA (OpenRouter). La varianza de 9x medida en docs/11-benchmarks.md viene de QUE
# PROVEEDOR sirve el modelo, no del modelo: el mismo gpt-oss-120b va a ~50 tok/s en un
# proveedor y a ~2.000 en otro. Estas dos variables son cómo se deja de depender del azar.
# Cualquiera de las dos entra en la clave de caché: activarlas invalida las respuestas
# guardadas, a propósito, porque pueden cambiar la salida. Sin medir, no se cambia.
#
# price | throughput | latency
OPENROUTER_PROVIDER_SORT=throughput
# Alternativa más fuerte: fijar la lista, p.ej. "Cerebras,Groq". Tiene prioridad sobre el sort.
#OPENROUTER_PROVIDER_ORDER=
# gpt-oss es un modelo con razonamiento: el grueso de su reloj son tokens de thinking.
# low | medium | high. Vacío = default del proveedor. Medido: low pierde 2 celdas de material,
# medium no pierde ninguna (docs/11-benchmarks.md §4).
LLM_REASONING_EFFORT=medium
# El crítico tiene su propio dial porque su modo de fallo es distinto: si ve poco, degrada
# líneas CORRECTAS y llena la cola de ruido (el fallo invisible del enunciado). A high:
# recall 43% / precisión 100% sobre los errores conocidos, 0 falsos positivos (§5-ter).
LLM_REASONING_EFFORT_CRITIC=high

# Peticiones en paralelo por etapa. Subirlo es la palanca directa para 1.000 filas;
# si el proveedor responde 429, los reintentos ya lo absorben.
CONCURRENCY=12

LLM_CACHE=on
LLM_CACHE_DIR=data/output/.llm-cache

# Umbrales de confianza. Justificación en docs/02-kpi.md §4
# La frontera resuelta/revisión se expresa como la procedencia MÁS DÉBIL admisible en una línea
# resuelta, no como un escalar: es una decisión de negocio y tiene que poder decirse en
# palabras del cliente. Ver src/lib/confidence.ts y docs/02-kpi.md §4.
THRESHOLD_MIN_PROVENANCE=inferred
# Las líneas resueltas por debajo de esto pasan por el crítico. Palanca de coste.
THRESHOLD_CRITIC=0.90

# Políticas — conmutables en caliente durante el challenge.
# Ver src/rules/policies.ts y docs/03-policies.md
POLICY_FINISH_SET_SCOPE=review
POLICY_IMPLICIT_MULTIPLICITY=infer_one
POLICY_MATERIAL_DERIVATION=from_quality
POLICY_UNITLESS_LENGTH=plausibility_range
POLICY_MISSING_STANDARD=review
POLICY_QUALITY_COHERENCE=review
POLICY_HV_SCOPE=anywhere
POLICY_OUT_OF_FAMILY=review
# P-10: un número desnudo (10, 125) en el campo medida de un set donde otro elemento lleva una
# medida bien formada. §6 dice que una medida es pulgadas o métrica; 'keep' vuelve al fallo.
POLICY_BARE_MEASURE_IN_SET=reject
# P-11: el valor que P-10 descarta, cuando el catálogo lo reconoce como calidad y es coherente con
# el tipo del elemento ('10' en una tuerca es G9). 'off' lo tira y la línea va a QUALITY_MISSING.
POLICY_REJECTED_MEASURE_AS_QUALITY=if_catalog_and_coherent
# P-12: acabado que el vocabulario no reconoce. 'resolve' = comportamiento publicado (sin motivo);
# 'review' = UNMAPPED_VALUE en la línea. Ver specs/SPEC-011-finish-vocabulary.md
POLICY_UNKNOWN_FINISH=resolve
